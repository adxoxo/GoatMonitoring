# =====================================================================
# GoatedTracking — environment template (SAFE TO COMMIT, no secrets)
#
# Setup:
#   cp .env.example backend/.env     # then fill in the BACKEND section
#   cp .env.example frontend/.env    # then fill in the FRONTEND section
#
# Real .env files are gitignored. Never commit filled-in values.
# =====================================================================

# ─────────────────────────────────────────────────────────────────────
# BACKEND  (backend/.env)
# ─────────────────────────────────────────────────────────────────────

# Django core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=goatfarm.local,localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.production

# Database (PostgreSQL — service name "db" inside Docker network)
# Django reads the DB_* vars below.
DB_NAME=goatfarm
DB_USER=goatfarm_user
DB_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432

# PostgreSQL container init — the postgres image only reads POSTGRES_* vars.
# These MUST match the DB_* values above (same db/user/password).
POSTGRES_DB=goatfarm
POSTGRES_USER=goatfarm_user
POSTGRES_PASSWORD=change-me-strong-password

# JWT (admin auth)
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=7

# Media (QR code image storage)
MEDIA_ROOT=/app/media
MEDIA_URL=/media/

# App
FARM_LOCAL_HOSTNAME=goatfarm.local

# CORS (development only — Vite dev server origin). Comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─────────────────────────────────────────────────────────────────────
# FRONTEND  (frontend/.env — Vite only exposes VITE_-prefixed vars)
# ─────────────────────────────────────────────────────────────────────

# Points to the local server — never the internet
VITE_API_BASE_URL=http://goatfarm.local/api/v1

# QR codes encode this + goat UUID
VITE_GOAT_PUBLIC_URL=http://goatfarm.local/g

# Feature flags
VITE_WORKER_AUTH_ENABLED=false

# UI
VITE_APP_NAME=GoatedTracking
